<mvc:View
  controllerName="homeui.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core">

  <App>
    <pages>
      <Page showHeader="false">
        <content>

          <!-- LOGIN / RESET AREA -->
          <HBox
            fitContainer="true"
            wrap="Wrap"
            visible="{= !${home>/isLoggedIn} }"
            class="homeLoginWrapper homeLoginSplitLayout">

            <VBox
              justifyContent="Center"
              class="homeLoginBrandPanel">

              <VBox class="homeLoginBrandContent">
                <Image
                  src="img/weslaty-logo.png"
                  width="16rem"
                  densityAware="false"
                  decorative="false"
                  class="homeBrandLogo sapUiMediumMarginBottom" />

                <Text text="HR PORTAL" class="homeLoginEyebrow" />
                <Title text="{home>/texts/appTitle}" level="H1" class="homeLoginHeroTitle" />
                <Text
                  text="Secure access to employee records, leave workflows, promotion processes and notifications."
                  wrapping="true"
                  class="homeLoginHeroSubtitle" />

                <VBox class="homeLoginHighlights sapUiLargeMarginTop">
                  <HBox alignItems="Center" class="homeLoginHighlightItem">
                    <core:Icon src="sap-icon://employee" class="homeLoginHighlightIcon" />
                    <Text text="Employee administration and master data" class="homeLoginHighlightText" />
                  </HBox>

                  <HBox alignItems="Center" class="homeLoginHighlightItem">
                    <core:Icon src="sap-icon://calendar" class="homeLoginHighlightIcon" />
                    <Text text="Leave approval and workflow tracking" class="homeLoginHighlightText" />
                  </HBox>

                  <HBox alignItems="Center" class="homeLoginHighlightItem">
                    <core:Icon src="sap-icon://bell" class="homeLoginHighlightIcon" />
                    <Text text="Centralized HR alerts and updates" class="homeLoginHighlightText" />
                  </HBox>
                </VBox>
              </VBox>
            </VBox>

            <VBox
              justifyContent="Center"
              alignItems="Center"
              class="homeLoginFormPanel">

              <VBox width="28rem" class="homeLoginCardWrapper">
                <Panel class="homeLoginPanel homeLoginPremiumPanel" backgroundDesign="Solid">
                  <VBox class="sapUiLargeMargin">

                    <VBox class="sapUiMediumMarginBottom">
                      <Title
                        text="{= ${home>/isResetMode} ? ${home>/texts/resetPassword} : ${home>/texts/login} }"
                        level="H2"
                        class="homeLoginCardTitle" />
                      <Text
                        text="{= ${home>/isResetMode} ? ${home>/texts/resetSubtitle} : ${home>/texts/loginSubtitle} }"
                        wrapping="true"
                        class="homeLoginCardSubtitle sapUiSmallMarginTop" />
                    </VBox>

                    <!-- LOGIN MODE -->
                    <VBox visible="{= !${home>/isResetMode} }">
                      <Label text="{home>/texts/email}" class="sapUiSmallMarginBottom" />
                      <Input
                        id="loginEmailInput"
                        width="100%"
                        value="{home>/loginEmail}"
                        type="Email"
                        placeholder="{home>/texts/email}" />

                      <Label text="{home>/texts/password}" class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
                      <Input
                        id="loginPasswordInput"
                        width="100%"
                        value="{home>/loginPassword}"
                        type="{= ${home>/showPassword} ? 'Text' : 'Password' }"
                        placeholder="{home>/texts/password}" />

                      <CheckBox
                        text="{home>/texts/showPassword}"
                        selected="{home>/showPassword}"
                        select=".onToggleShowPassword"
                        class="sapUiSmallMarginTop" />

                      <Button
                        text="{home>/texts/login}"
                        type="Emphasized"
                        press=".onLoginPress"
                        class="sapUiMediumMarginTop homePrimaryLoginButton"
                        width="100%" />

                      <Button
                        text="{home>/texts/forgotPassword}"
                        type="Transparent"
                        press=".onForgotPasswordPress"
                        class="sapUiSmallMarginTop"
                        width="100%" />
                    </VBox>

                    <!-- RESET PASSWORD MODE -->
                    <VBox visible="{home>/isResetMode}">
                      <Label text="{home>/texts/newPassword}" class="sapUiSmallMarginBottom" />
                      <Input
                        id="resetPasswordInput"
                        width="100%"
                        value="{home>/resetPassword}"
                        type="{= ${home>/showResetPassword} ? 'Text' : 'Password' }"
                        placeholder="{home>/texts/newPassword}" />

                      <Label text="{home>/texts/confirmPassword}" class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
                      <Input
                        id="resetConfirmPasswordInput"
                        width="100%"
                        value="{home>/resetConfirmPassword}"
                        type="{= ${home>/showResetPassword} ? 'Text' : 'Password' }"
                        placeholder="{home>/texts/confirmPassword}" />

                      <CheckBox
                        text="{home>/texts/showPassword}"
                        selected="{home>/showResetPassword}"
                        select=".onToggleShowResetPassword"
                        class="sapUiSmallMarginTop" />

                      <Button
                        text="{home>/texts/resetPassword}"
                        type="Emphasized"
                        press=".onResetPasswordPress"
                        class="sapUiMediumMarginTop homePrimaryLoginButton"
                        width="100%" />

                      <Button
                        text="{home>/texts/backToLogin}"
                        type="Transparent"
                        press=".onBackToLoginPress"
                        class="sapUiSmallMarginTop"
                        width="100%" />
                    </VBox>

                  </VBox>
                </Panel>
              </VBox>
            </VBox>
          </HBox>

          <!-- DASHBOARD AREA -->
          <VBox fitContainer="true" visible="{home>/isLoggedIn}" class="homeDashboardPage">

            <Toolbar class="homeShellBar">
              <Image
                src="img/weslaty-logo.png"
                width="7rem"
                densityAware="false"
                decorative="false"
                class="homeToolbarLogo sapUiTinyMarginEnd" />
              <Title text="{home>/texts/appTitle}" level="H4" class="homeShellTitle" />
              <ToolbarSpacer />
              <Button text="{home>/texts/home}" type="Transparent" />
              <Button
                text="{home>/userName}"
                icon="sap-icon://employee"
                type="Transparent"
                press=".onOpenUserMenu"
                tooltip="{home>/texts/myProfile}" />
            </Toolbar>

            <ScrollContainer height="100%" vertical="true" horizontal="false" class="homeScrollContainer">
              <VBox class="homeContentWrapper">

                <!-- Premium hero -->
                <HBox wrap="Wrap" justifyContent="SpaceBetween" alignItems="Center" class="homePremiumHero">
                  <VBox class="homePremiumHeroLeft">
                    <Text
                      text="{= ${home>/greeting} + ', ' + ${home>/userName} }"
                      class="homeGreetingText" />
                    <Title text="{home>/texts/workspaceTitle}" level="H1" class="homePremiumHeroTitle" />
                    <Text text="{home>/texts/workspaceSubtitle}" wrapping="true" class="homePremiumHeroSubtitle" />

                    <HBox wrap="Wrap" class="homeHeroInfoRow sapUiSmallMarginTop">
                      <ObjectStatus text="{home>/role}" state="Information" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                      <ObjectStatus text="{home>/department}" state="None" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                    </HBox>
                  </VBox>

                  <VBox class="homePremiumHeroRight" alignItems="End">
                    <Text text="{home>/texts/todayLabel}" class="homeHeroDateLabel" />
                    <Text text="{home>/currentDateText}" class="homeHeroDateValue sapUiTinyMarginTop" />
                  </VBox>
                </HBox>

                <!-- KPI Cards -->
                <VBox class="homeSectionBlock">
                  <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                    <Title text="{home>/texts/overview}" level="H4" class="homeSectionTitleNoMargin" />
                    <Text text="{home>/texts/pendingApprovals}" class="homeSectionHint" />
                  </HBox>

                  <HBox wrap="Wrap" class="homeStatsCardsRow">

                    <VBox class="homeStatCard homeStatCardBlue homeClickableCard">
                      <Button type="Transparent" press=".onOpenEmployeesKpi" class="homeCardOverlayButton" />
                      <HBox justifyContent="SpaceBetween" alignItems="Start">
                        <VBox>
                          <Text text="{home>/texts/employees}" class="homeStatLabel" />
                          <Title text="{home>/stats/employees}" level="H2" class="homeStatValue" />
                        </VBox>
                        <core:Icon src="sap-icon://employee" class="homeStatIcon" />
                      </HBox>
                    </VBox>

                    <VBox class="homeStatCard homeStatCardOrange homeClickableCard">
                      <Button type="Transparent" press=".onOpenLeaveKpi" class="homeCardOverlayButton" />
                      <HBox justifyContent="SpaceBetween" alignItems="Start">
                        <VBox>
                          <Text text="{home>/texts/pendingLeaveRequests}" class="homeStatLabel" />
                          <Title text="{home>/stats/leave}" level="H2" class="homeStatValue" />
                        </VBox>
                        <core:Icon src="sap-icon://calendar" class="homeStatIcon" />
                      </HBox>
                    </VBox>

                    <VBox class="homeStatCard homeStatCardPurple homeClickableCard">
                      <Button type="Transparent" press=".onOpenPromotionsKpi" class="homeCardOverlayButton" />
                      <HBox justifyContent="SpaceBetween" alignItems="Start">
                        <VBox>
                          <Text text="{home>/texts/promotionRequests}" class="homeStatLabel" />
                          <Title text="{home>/stats/promotions}" level="H2" class="homeStatValue" />
                        </VBox>
                        <core:Icon src="sap-icon://business-objects-experience" class="homeStatIcon" />
                      </HBox>
                    </VBox>

                    <VBox class="homeStatCard homeStatCardGreen homeClickableCard">
                      <Button type="Transparent" press=".onOpenNotificationsKpi" class="homeCardOverlayButton" />
                      <HBox justifyContent="SpaceBetween" alignItems="Start">
                        <VBox>
                          <Text text="{home>/texts/unreadNotifications}" class="homeStatLabel" />
                          <Title text="{home>/stats/notifications}" level="H2" class="homeStatValue" />
                        </VBox>
                        <core:Icon src="sap-icon://bell" class="homeStatIcon" />
                      </HBox>
                    </VBox>

                  </HBox>
                </VBox>

                <!-- Modules -->
                <VBox class="homeSectionBlock">
                  <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                    <Title text="{home>/texts/modules}" level="H4" class="homeSectionTitleNoMargin" />
                    <Text text="{home>/texts/applications}" class="homeSectionHint" />
                  </HBox>

                  <l:Grid defaultSpan="XL4 L4 M6 S12" hSpacing="1" vSpacing="1" class="homeModulesGrid">

                    <Panel class="homeModuleCard">
                      <VBox class="homeModuleCardContent">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                          <core:Icon src="sap-icon://employee" class="homeModuleIcon homeModuleIconBlue" />
                          <ObjectStatus text="{home>/texts/masterData}" state="Information" />
                        </HBox>
                        <Title text="{home>/texts/employees}" level="H5" class="homeModuleTitle sapUiSmallMarginTop" />
                        <Text text="{home>/texts/employeesSub}" wrapping="true" class="homeModuleDescription sapUiSmallMarginTop" />
                        <Button
                          text="{home>/texts/openModule}"
                          press=".onOpenEmployees"
                          type="Emphasized"
                          class="homeModuleButton sapUiMediumMarginTop" />
                      </VBox>
                    </Panel>

                    <Panel class="homeModuleCard">
                      <VBox class="homeModuleCardContent">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                          <core:Icon src="sap-icon://calendar" class="homeModuleIcon homeModuleIconOrange" />
                          <ObjectStatus text="{home>/texts/workflow}" state="Warning" />
                        </HBox>
                        <Title text="{home>/texts/pendingLeaveRequests}" level="H5" class="homeModuleTitle sapUiSmallMarginTop" />
                        <Text text="{home>/texts/leaveSub}" wrapping="true" class="homeModuleDescription sapUiSmallMarginTop" />
                        <Button
                          text="{home>/texts/openModule}"
                          press=".onOpenLeaveRequests"
                          type="Emphasized"
                          class="homeModuleButton sapUiMediumMarginTop" />
                      </VBox>
                    </Panel>

                    <Panel class="homeModuleCard">
                      <VBox class="homeModuleCardContent">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                          <core:Icon src="sap-icon://business-objects-experience" class="homeModuleIcon homeModuleIconPurple" />
                          <ObjectStatus text="{home>/texts/workflow}" state="Information" />
                        </HBox>
                        <Title text="{home>/texts/promotionRequests}" level="H5" class="homeModuleTitle sapUiSmallMarginTop" />
                        <Text text="{home>/texts/promotionSub}" wrapping="true" class="homeModuleDescription sapUiSmallMarginTop" />
                        <Button
                          text="{home>/texts/openModule}"
                          press=".onOpenPromotions"
                          type="Emphasized"
                          class="homeModuleButton sapUiMediumMarginTop" />
                      </VBox>
                    </Panel>

                    <Panel class="homeModuleCard">
                      <VBox class="homeModuleCardContent">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                          <core:Icon src="sap-icon://feedback" class="homeModuleIcon homeModuleIconIndigo" />
                          <ObjectStatus text="{home>/texts/history}" state="None" />
                        </HBox>
                        <Title text="{home>/texts/feedbacks}" level="H5" class="homeModuleTitle sapUiSmallMarginTop" />
                        <Text text="{home>/texts/feedbackSub}" wrapping="true" class="homeModuleDescription sapUiSmallMarginTop" />
                        <Button
                          text="{home>/texts/openModule}"
                          press=".onOpenPromotionFeedbacks"
                          type="Emphasized"
                          class="homeModuleButton sapUiMediumMarginTop" />
                      </VBox>
                    </Panel>

                    <Panel class="homeModuleCard">
                      <VBox class="homeModuleCardContent">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                          <core:Icon src="sap-icon://bell" class="homeModuleIcon homeModuleIconGreen" />
                          <ObjectStatus text="{home>/texts/communication}" state="Success" />
                        </HBox>
                        <Title text="{home>/texts/notifications}" level="H5" class="homeModuleTitle sapUiSmallMarginTop" />
                        <Text text="{home>/texts/notificationsSub}" wrapping="true" class="homeModuleDescription sapUiSmallMarginTop" />
                        <Button
                          text="{home>/texts/openModule}"
                          press=".onOpenNotifications"
                          type="Emphasized"
                          class="homeModuleButton sapUiMediumMarginTop" />
                      </VBox>
                    </Panel>

                  </l:Grid>
                </VBox>

                <!-- Quick Actions -->
                <VBox class="homeSectionBlock homeQuickActionSection">
                  <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                    <Title text="{home>/texts/quickActions}" level="H4" class="homeSectionTitleNoMargin" />
                    <Text text="{home>/texts/quickAccessDescription}" class="homeSectionHint" />
                  </HBox>

                  <HBox wrap="Wrap" class="homeQuickActionsRow">
                    <Button
                      text="{home>/texts/openLeaveRequests}"
                      type="Emphasized"
                      press=".onOpenLeaveRequests"
                      class="homeActionButton" />
                    <Button
                      text="{home>/texts/openPromotionRequests}"
                      press=".onOpenPromotions"
                      class="homeActionButton" />
                    <Button
                      text="{home>/texts/openNotifications}"
                      press=".onOpenNotifications"
                      class="homeActionButton" />
                  </HBox>
                </VBox>

              </VBox>
            </ScrollContainer>
          </VBox>

        </content>
      </Page>
    </pages>
  </App>

  <Popover
    id="userMenuPopover"
    placement="Bottom"
    showHeader="false">
    <List>
      <StandardListItem
        title="{home>/texts/myProfile}"
        type="Active"
        icon="sap-icon://employee"
        press=".onProfilePress" />
      <StandardListItem
        title="{home>/texts/settings}"
        type="Active"
        icon="sap-icon://action-settings"
        press=".onOpenSettings" />
      <StandardListItem
        title="{home>/texts/logout}"
        type="Active"
        icon="sap-icon://log"
        press=".onLogoutPress" />
    </List>
  </Popover>

  <Dialog
    id="forgotPasswordDialog"
    title="{home>/texts/forgotPassword}"
    contentWidth="28rem"
    draggable="true"
    resizable="false">
    <content>
      <VBox class="sapUiMediumMargin">
        <Text text="{home>/texts/forgotPasswordSubtitle}" wrapping="true" class="sapUiSmallMarginBottom" />
        <Label text="{home>/texts/email}" class="sapUiSmallMarginBottom" />
        <Input
          id="forgotPasswordEmailInput"
          value="{home>/forgotPasswordEmail}"
          type="Email"
          width="100%"
          placeholder="{home>/texts/email}" />
      </VBox>
    </content>
    <beginButton>
      <Button
        text="{home>/texts/sendResetLink}"
        type="Emphasized"
        press=".onSubmitForgotPasswordPress" />
    </beginButton>
    <endButton>
      <Button
        text="{home>/texts/close}"
        press=".onCloseForgotPasswordDialog" />
    </endButton>
  </Dialog>

  <Dialog
    id="profileDialog"
    title="{home>/texts/myProfile}"
    contentWidth="32rem"
    draggable="true"
    resizable="true">

    <content>
      <VBox class="sapUiMediumMargin">
        <ObjectHeader
          title="{home>/profile/fullName}"
          number="{home>/profile/jobTitle}"
          intro="{home>/profile/department}" />

        <f:SimpleForm
          editable="false"
          layout="ResponsiveGridLayout"
          class="sapUiMediumMarginTop">
          <f:content>
            <Label text="{home>/texts/role}" />
            <Text text="{home>/profile/role}" />

            <Label text="{home>/texts/jobTitle}" />
            <Text text="{home>/profile/jobTitle}" />

            <Label text="{home>/texts/department}" />
            <Text text="{home>/profile/department}" />

            <Label text="{home>/texts/manager}" />
            <Text text="{home>/profile/manager}" />

            <Label text="{home>/texts/email}" />
            <Text text="{home>/profile/email}" />

            <Label text="{home>/texts/phone}" />
            <Text text="{home>/profile/phone}" />

            <Label text="{home>/texts/hireDate}" />
            <Text text="{home>/profile/hireDate}" />

            <Label text="{home>/texts/yearsHere}" />
            <Text text="{home>/profile/yearsHere}" />
          </f:content>
        </f:SimpleForm>
      </VBox>
    </content>

    <beginButton>
      <Button text="{home>/texts/close}" press=".onCloseProfileDialog" />
    </beginButton>
  </Dialog>

  <Dialog
    id="settingsDialog"
    title="{home>/texts/settings}"
    contentWidth="24rem"
    draggable="true"
    resizable="true">

    <content>
      <VBox class="sapUiMediumMargin">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
          <f:content>
            <Label text="{home>/texts/language}" />
            <Select selectedKey="{home>/selectedLanguage}">
              <items>
                <core:Item key="en" text="English" />
                <core:Item key="fr" text="Français" />
              </items>
            </Select>
          </f:content>
        </f:SimpleForm>
      </VBox>
    </content>

    <beginButton>
      <Button text="{home>/texts/save}" type="Emphasized" press=".onSaveSettings" />
    </beginButton>
    <endButton>
      <Button text="{home>/texts/close}" press=".onCloseSettingsDialog" />
    </endButton>
  </Dialog>

</mvc:View>