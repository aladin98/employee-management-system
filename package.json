{
  "name": "employee-management-system",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-employee-ui": "cds watch --open my.company.hr.employeeui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-leave-requests-ui": "cds watch --open my.company.hr.leaverequestsui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-promotions-ui": "cds watch --open my.company.hr.promotionsui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employee-ui",
    "app/leave-requests-ui",
    "app/promotions-ui"
  ]
}
